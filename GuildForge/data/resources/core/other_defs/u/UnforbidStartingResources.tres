[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/u/UnforbidStartingResources.tres")"
text = Color(To allow your colonists to bring your items to the stockpile, you must remove the items' "forbidden" designation.\n\n1. Clicking your starting items to select them.\n2. Click the ALLOW toggle button to allow them.\n\n(Pro tip: Double-click an item to select all on screen of the same type.)\n\nAlternatively, you can:\n1. Click ARCHITECT.\n2. Click ORDERS.\n3. Click ALLOW.\n4. Drag out a shape covering all forbidden items to allow them., 1.0)
instructionClass = "Instruction_UnforbidStartingResources"
eventTagInitiate = "InstructionDeactivated-EndStockpileDesignating"
actionTagsAllowed = SubResource(1)
rejectInputMessage = "Please allow your starting items."
highlightTags = SubResource(2)
onMapInstruction = "Allow this"