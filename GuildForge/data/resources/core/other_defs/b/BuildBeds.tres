[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/b/BuildBeds.tres")"
text = "Your colonists will now build the room!\n\nNow they need somewhere to sleep. Place three BEDS inside the room.\n\nFind them in the FURNITURE category.\n\nYou can use the {Key:Designator_RotateLeft} and {Key:Designator_RotateRight} keys to rotate the building."
textController = "Your colonists will now build the room!\n\nNow they need somewhere to sleep. Place three BEDS inside the room.\n\nFind them in the FURNITURE category.\n\nYou can rotate the building by pressing the rotate buttons on the left."
instructionClass = "Instruction_BuildInRoom"
eventTagInitiate = "InstructionDeactivated-BuildRoomDoor"
actionTagsAllowed = SubResource(1)
highlightTags = SubResource(2)
thingDef = "ExtResource("res://GuildForge/data/resources/core/other_defs/b/Bed.tres")"
targetCount = "3"
onMapInstruction = "Build three beds inside the room"
rejectInputMessage = "Please build wooden beds inside the room."
resetBuildDesignatorStuffs = "true"