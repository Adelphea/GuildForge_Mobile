[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_ConceptDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/s/ShotAccuracyTooltip.tres")"
label = "Shot accuracy tooltip"
priority = "1"
helpText = Color(You can see the exact calculations behind the accuracy of any shot.\n\nTo do so, select the shooter, then rest the mouse over the target. The tooltip will show the chance to hit, and a breakdown of the contribution of various to-hit chance multipliers.)