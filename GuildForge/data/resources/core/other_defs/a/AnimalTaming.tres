script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_ConceptDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/a/AnimalTaming.tres")"
label = "Animal taming"
priority = "10.1"
helpText = "You can assign colonists to tame a wild animal with the TAME designator.\n\nColonists will offer the animal food and attempt to tame it.\n\nBeware: Some animals can respond violently to failed taming attempts."
