[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_SpecialThingFilterDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/a/AllowDeadmansApparel.tres")"
