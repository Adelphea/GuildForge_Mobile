[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/m/MakeGrowingZone.tres")"
text = "The house is being built!\n\nYour colonists will need something to eat, so place a GROWING ZONE as indicated on the map.\n\nThis is where your colonists will sow crops."
instructionClass = "Instruction_PlaceGrowingZone"
eventTagInitiate = "InstructionDeactivated-BuildHorseshoesPin"
actionTagsAllowed = SubResource(1)
eventTagsEnd = SubResource(2)
rejectInputMessage = "Please make a growing zone on the indicated area."
highlightTags = SubResource(3)
onMapInstruction = "Place growing zone here\n(drag corner-to-corner)"