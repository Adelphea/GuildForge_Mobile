[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/m/MineSteel.tres")"
text = "Now your colonists will cook some food! Tasty!\n\nNext, you'll want to mine some minerals. I've spawned some mineable steel near your base.\n\nSelect the MINE designator and drag over the steel to designate it for mining."
instructionClass = "Instruction_MineSteel"
eventTagInitiate = "InstructionDeactivated-AddBillSimpleMeal"
actionTagsAllowed = SubResource(1)
highlightTags = SubResource(2)
rejectInputMessage = "Please use the 'mine' designator on the compacted steel."
onMapInstruction = "Designate all this\nfor mining"