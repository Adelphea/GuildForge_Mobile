[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/m/MakeStockpile.tres")"
text = "Great!\n\nNow, make a stockpile so your colonists know where to keep items.\n\n1. Click ARCHITECT tab in the bottom left.\n2. Click the ZONE/AREA category.\n3. Select the CREATE STOCKPILE tool.\n4. Click and drag out a square as indicated on the map."
instructionClass = "Instruction_PlaceStockpile"
eventTagInitiate = "InstructionDeactivated-TimeControls"
actionTagsAllowed = SubResource(1)
eventTagsEnd = SubResource(2)
rejectInputMessage = "Please make a stockpile on the indicated area."
highlightTags = SubResource(3)
onMapInstruction = "Place stockpile here\n(drag corner-to-corner)"