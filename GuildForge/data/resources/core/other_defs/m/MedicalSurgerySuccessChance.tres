[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_StatDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_StatDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/m/MedicalSurgerySuccessChance.tres")"
label = "medical surgery success chance"
description = "The base chance that a character will succeed when performing a medical operation.\n\nThe actual success chance is also affected by factors like facilities, room cleanliness, medicine used, the difficulty of the surgery, and inspirations.\n\nNo matter how high this stat is, there is always a small chance of failure on any operation."
category = "ExtResource("res://GuildForge/data/resources/core/other_defs/p/PawnWork.tres")"
defaultBaseValue = "1.00"
minValue = "0.01"
toStringStyle = "PercentZero"
skillNeedFactors = SubResource(1)
capacityFactors = SubResource(4)
scenarioRandomizable = "true"
displayPriorityInCategory = "4653"