defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/n/NakedBrutality.tres")"
label = "Naked Brutality"
description = Color(You went under anesthetic for a minor surgery. Now you've awoken in a drop pod crashing into a distant planet. You're naked, alone, and totally unprepared. Can you survive?\n\nWarning: There is nothing fair about this scenario - it is extremely difficult and death can happen for any reason., 1.0)
