label = "inspired creativity"
baseDurationDays = "8"
beginLetter = Color(The next item, art, or furniture [PAWN_pronoun] creates will be two quality levels higher than it would otherwise be. This even allows the creation of legendary items.\n\nThe inspiration will end after 8 days, or when the creation is completed.)
