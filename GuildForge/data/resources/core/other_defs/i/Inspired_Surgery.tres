[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InspirationDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InspirationDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/i/Inspired_Surgery.tres")"
label = "inspired surgery"
baseDurationDays = "8"
beginLetter = Color(The next time [PAWN_pronoun] performs a surgery, [PAWN_possessive] chance of success will be doubled. A small minimum chance of failure still applies.\n\nThe inspiration will end after 8 days, or when the surgery is performed., 1.0)
beginLetterDef = "ExtResource("res://GuildForge/data/resources/core/other_defs/p/PositiveEvent.tres")"
endMessage = "{0} is no longer inspired (inspired surgery)."
baseInspectLine = "Inspired: Inspired surgery"
minAge = "13"
requiredNonDisabledStats = SubResource(1)
requiredNonDisabledWorkTypes = SubResource(2)
requiredSkills = SubResource(3)
associatedSkills = SubResource(4)
requiredCapacities = SubResource(5)