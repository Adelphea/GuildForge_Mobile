[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_ConceptDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_ConceptDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/q/QueueOrders.tres")"
label = "Order queueing"
helpText = "When giving commands to pawns, you can queue up multiple orders by holding "shift". This also works when giving jobs to undrafted pawns."
helpTextController = "When giving commands to pawns, you can queue up multiple orders by holding {Key:QueueOrder}. This also works when giving jobs to undrafted pawns."