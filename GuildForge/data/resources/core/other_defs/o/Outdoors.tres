[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_NeedDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_NeedDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/o/Outdoors.tres")"
needClass = "Need_Outdoors"
label = "outdoors"
description = Color(Outdoors expresses the need not to be cooped up inside. It is harmed by long periods inside, especially underground. It improves when someone spends time under the sky, especially outdoors. It's not about the size of the rooms, but the need to be outside from time to time. Lack of outdoors time is a significant challenge for people who dwell in underground bases.)
minIntelligence = "ExtResource("res://GuildForge/data/resources/core/other_defs/h/Humanlike.tres")"
colonistAndPrisonersOnly = "true"
listPriority = "100"
freezeWhileSleeping = "true"