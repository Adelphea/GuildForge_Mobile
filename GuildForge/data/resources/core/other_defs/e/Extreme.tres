[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_DifficultyDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_DifficultyDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/e/Extreme.tres")"
label = "losing is fun"
description = "This setting is designed to be unfair. Huge threats will crash upon you without mercy until your colony dies. Only choose this setting if you are happy with the drama of struggling and dying.

(*SectionTitle)Recommended for:(/SectionTitle)

- Experienced players who want to face a brutal, unfair challenge where even great skill may not prevent death.
- Lovers of tragedy.
- Digital masochists."
difficulty = "5"
threatScale = "2.2"
adaptationEffectFactor = "0.4"
colonistMoodOffset = "-10"
tradePriceFactorLoss = "0.20"
cropYieldFactor = "0.8"
mineYieldFactor = "0.8"
butcherYieldFactor = "0.8"
fishingYieldFactor = "0.8"
researchSpeedFactor = "0.9"
diseaseIntervalFactor = "0.9"
enemyReproductionRateFactor = "1"
playerPawnInfectionChanceFactor = "1.1"
deepDrillInfestationChanceFactor = "1.3"
wastepackInfestationChanceFactor = "2"
nomadicMineableResourcesFactor = "0.5"
foodPoisonChanceFactor = "1.2"
maintenanceCostFactor = "1"
enemyDeathOnDownedChanceFactor = "1"
adaptationGrowthRateFactorOverZero = "1"
scariaRotChance = "0.818"
studyEfficiencyFactor = "0.8"