[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/core/other_defs/e/ExpandAreaBuildRoof.tres")"
text = "The BUILD ROOF AREA defines where your colonists will try to build roofs.\n\nIt auto-fills when you enclose a new room.\n\nSelect the EXPAND BUILD ROOF AREA tool and drag out the shape of a porch roof on the front of the house."
instructionClass = "Instruction_ExpandAreaBuildRoof"
eventTagInitiate = "InstructionDeactivated-ExpandAreaHome"
actionTagsAllowed = SubResource(1)
highlightTags = SubResource(2)
rejectInputMessage = "Please expand the build roof area a bit, just for practice."
targetCount = "10"