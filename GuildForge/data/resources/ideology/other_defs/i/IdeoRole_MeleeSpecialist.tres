defName = "ExtResource("res://GuildForge/data/resources/ideology/other_defs/i/IdeoRole_MeleeSpecialist.tres")"
label = "melee specialist"
description = "A special ideoligious status focusing on melee combat to the exclusion of all else. This specialized role gives increased dodge and hit chance in melee combat and the ability to enter a short-term berserk trance. Holders of this role will refuse to do many kinds of non-melee-related work."
