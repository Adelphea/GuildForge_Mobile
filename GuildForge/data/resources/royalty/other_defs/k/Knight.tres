[gd_resource type="Script" path="res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_RoyalTitleDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/GuildForge/scripts/resources/other_defs/CR_RoyalTitleDef.gd")
defName = "ExtResource("res://GuildForge/data/resources/royalty/other_defs/k/Knight.tres")"
label = "knight"
description = "The title of knight is held by agents of the psychic cult who have fully passed their training, but who have not ascended to higher leadership roles. Many knights never advance further, and spend their lives as respected warriors, advisors, or commanders.\n\nIn war, some knights lead troop companies and assault squadrons, while psychic-focused knights engage in espionage, sabotage, and battlefield psychic combat."
