[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/ArchotechEye.tres")"
label = "archotech eye"
labelNoun = "an archotech eye"
description = "An installed archotech eye. It perceives every type of electromagnetic radiation, including radio waves, infrared, light, x-rays, and gamma rays. Its visual acuity is precise enough to read handwriting from twenty meters away. It can emit various wavelengths of radiation like a flashlight, and has an internal subpersona AI which helps highlight useful visual information. Its internal workings are a mystery to human minds."
descriptionHyperlinks = SubResource(1)
spawnThingOnRemoved = "ExtResource("res://GuildForge/data/defs/ArchotechEye.tres")"
addedPartProps = SubResource(2)
renderNodeProperties = SubResource(3)