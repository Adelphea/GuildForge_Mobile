[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/AcceptStartingPawns.tres")"
text = "Great!\n\nReorder and randomize more if you want - but don't try to get the perfect characters. Everyone has flaws, and it makes the story more interesting!\n\nYou can also re-name the characters by clicking on their names.\n\nClick START when you're ready."
eventTagInitiate = "RandomizePawn"
actionTagsAllowed = SubResource(1)
eventTagsEnd = SubResource(2)
highlightTags = SubResource(3)