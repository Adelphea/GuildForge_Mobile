[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/AlcoholAddiction.tres")"
label = "alcohol addiction"
description = "A chemical addiction to alcohol. Long-term presence of alcohol has caused neurological adaptations at the cellular level, so the brain can no longer function properly without the drug.
\nWithout regular doses of alcohol, withdrawal symptoms will begin. However, extended abstinence will force the brain to adapt back to its normal state, resolving the addiction."
hediffClass = "Hediff_Addiction"
chemicalNeed = "ExtResource("res://GuildForge/data/defs/Chemical_Alcohol.tres")"
comps = Array[SubResource(1)]
stages = SubResource(2)