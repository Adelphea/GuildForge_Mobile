[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/TribeChild40.tres")"
title = "tribe child"
titleShort = "tribal"
description = Color([PAWN_nameDef] grew up in a tribe, running around the village, moving with the muffalo herds, learning essential skills from [PAWN_possessive] parents.\n\n[PAWN_pronoun] never learned to read and never saw a machine that wasn't an ancient ruin.)
slot = "Childhood"
skillGains = SubResource(1)
spawnCategories = SubResource(2)