[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_FactionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_FactionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/TribeRough.tres")"
label = "fierce tribe"
description = "These people have been here a very long time. Maybe their ancestors crashed here a thousand years ago. Maybe they survived some cataclysm that destroyed a technological civilization here. In any case, the tribals are mostly nomadic people who live off the land using primitive tools and weapons.\n\nDespite their apparent technological weakness, the tribals can be dangerous enemies and valuable friends because of their skill with low-tech warfare, their numbers, and their hardiness.\n\nThis particular tribe values warlike dominance; it may be difficult to turn them into an ally."
factionIconPath = "World/WorldObjects/Expanding/VillageRough"