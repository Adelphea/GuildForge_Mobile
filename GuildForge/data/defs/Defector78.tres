defName = "ExtResource("res://GuildForge/data/defs/Defector78.tres")"
title = "defector"
titleShort = "defector"
description = Color(Early in [PAWN_possessive] adulthood, [PAWN_nameDef] decided to leave the oppressive dictatorship where [PAWN_pronoun] lived. [PAWN_possessive] defection was not well-received, and agents were sent out after [PAWN_objective].\n\n[PAWN_pronoun] spent years on the run, treating [PAWN_possessive] own wounds so no doctor could betray [PAWN_objective]. The ordeal made [PAWN_objective] bitter and untrusting.)
slot = "Adulthood"
workDisables = SubResource(1)
requiredWorkTags = SubResource(2)
skillGains = SubResource(3)
spawnCategories = SubResource(4)
bodyTypeMale = "ExtResource("res://GuildForge/data/defs/Male.tres")"
bodyTypeFemale = "ExtResource("res://GuildForge/data/defs/Female.tres")"