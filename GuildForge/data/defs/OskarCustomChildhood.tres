[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/OskarCustomChildhood.tres")"
slot = "Childhood"
title = "art slave"
titleShort = "artist"
description = Color([PAWN_nameDef] was born on the dark edge of a tidally-locked urbworld. After an argument, [PAWN_possessive] father sold [PAWN_objective] to a local district lord as a slave artist.\n\nForced to create art or be punished, [PAWN_pronoun] withdrew and became unable to form relations with others., 1.0)
skillGains = SubResource(1)
workDisables = SubResource(2)