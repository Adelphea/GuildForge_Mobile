[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_InspirationDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_InspirationDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Inspired_Recruitment.tres")"
label = "inspired recruitment"
baseDurationDays = "8"
beginLetter = Color([PAWN_pronoun] will successfully recruit the next prisoner regardless of difficulty or resistance, as long as they are not unwaveringly loyal.\n\nThe inspiration will end after 8 days, or when the prisoner is recruited., 1.0)
beginLetterDef = "ExtResource("res://GuildForge/data/defs/PositiveEvent.tres")"
endMessage = "{0} is no longer inspired (inspired recruitment)."
baseInspectLine = "Inspired: Inspired recruitment"
minAge = "10"
requiredNonDisabledStats = SubResource(1)
requiredNonDisabledWorkTypes = SubResource(2)
requiredSkills = SubResource(3)
associatedSkills = SubResource(4)
requiredCapacities = SubResource(5)