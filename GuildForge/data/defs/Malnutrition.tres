[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Malnutrition.tres")"
label = "malnutrition"
description = "Abnormally low body fat and weight, typically caused by lack of food. Malnutrition is always very unpleasant, but its initial effects are mild. Without food, though, a malnourished creature will waste away, losing muscle mass and capacities. Malnutrition ends with death. Upon re-feeding malnutrition naturally recovers over time. Malnourished creatures have larger appetites than normal."
lethalSeverity = "1"
scenarioCanAdd = "true"
stages = SubResource(1)