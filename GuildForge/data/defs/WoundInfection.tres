[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/WoundInfection.tres")"
label = "infection"
labelNoun = "an infection"
description = "Bacterial infection in a wound. Without treatment, the bacteria will multiply, killing local tissue, and eventually causing blood poisoning and death.
\nThrough aeons of human warfare, infections have often taken more lives than the wounds themselves."
makesSickThought = "true"
lethalSeverity = "1"
tendable = "true"
comps = Array[SubResource(1), SubResource(2), SubResource(3)]
stages = SubResource(4)