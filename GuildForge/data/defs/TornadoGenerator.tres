[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ThingDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/TornadoGenerator.tres")"
label = "tornado generator"
description = Color(An ancient control unit for a network of weather-control satellites. This device has had certain failsafes bypassed; it is capable of causing a massive air current disturbance, which will generate a tornado at a chosen location. The weather network will detect this unauthorized intrusion and lock out the device after use, but the tornado will be left to spend its energy normally., 1.0)
thingSetMakerTags = SubResource(1)
statBases = SubResource(2)
apparel = SubResource(3)
verbs = SubResource(4)
comps = Array[SubResource(7)]
tradeTags = SubResource(8)