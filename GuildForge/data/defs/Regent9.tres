[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Regent9.tres")"
title = "regent"
titleShort = "regent"
description = Color(When [PAWN_nameDef]'s family's ally was killed, and [PAWN_possessive] young son inherited his throne, [PAWN_nameDef] was appointed as regent to rule in the child's stead.
\n[PAWN_pronoun] oversaw diverse matters of house and title, from finances to war to greedy relatives intent on usurping the throne. [PAWN_nameDef] never abused [PAWN_possessive] position.)
slot = "Adulthood"
