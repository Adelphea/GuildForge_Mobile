[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/PsychiteAddiction.tres")"
label = "psychite addiction"
description = "A chemical addiction to psychite. Long-term presence of psychite has caused neurological adaptations at the cellular level, so the brain can no longer function properly without the drug.
\nWithout regular doses of psychite from drugs like flake or yayo, withdrawal symptoms will begin. However, extended abstinence will force the brain to adapt back to its normal state, resolving the addiction."
hediffClass = "Hediff_Addiction"
chemicalNeed = "ExtResource("res://GuildForge/data/defs/Chemical_Psychite.tres")"
comps = Array[SubResource(1)]
stages = SubResource(2)