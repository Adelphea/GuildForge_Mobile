[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_StatDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_StatDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/GeneralLaborSpeed.tres")"
label = "general labor speed"
description = "The speed at which this person carries out general labor like making stone blocks, making chemfuel at a refinery, burning items, tailoring clothes, creating art, smithing armor and weapons or smelting slag. This stat applies both to activities that involve no skill, as well as those where the skill affects the quality of the product instead of the speed of production."
category = "ExtResource("res://GuildForge/data/defs/PawnWork.tres")"
defaultBaseValue = "1"
minValue = "0.1"
toStringStyle = "PercentZero"
statFactors = SubResource(1)
capacityFactors = SubResource(2)
displayPriorityInCategory = "4999"