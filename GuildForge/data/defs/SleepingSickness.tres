[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/SleepingSickness.tres")"
label = "sleeping sickness"
description = "An infectious disease caused by an insect-borne parasite. Sleeping sickness is not as deadly as some other diseases, but progresses slowly. The body takes a long time to clear the infection."
lethalSeverity = "1"
makesSickThought = "true"
tendable = "true"
comps = Array[SubResource(1), SubResource(2)]
stages = SubResource(3)