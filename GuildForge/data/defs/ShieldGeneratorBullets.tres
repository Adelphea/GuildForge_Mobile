[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ThingDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/ShieldGeneratorBullets.tres")"
label = "mech low-shield"
description = "A shielding device which projects a momentum repulsor field. Shots can go out, but not in.\n\nThis one is tuned to low angles, so it will block ground-level projectiles like bullets.\n\nThe unit can be temporarily disabled by EMP attacks, either by shocking the projector unit itself, or using EMP munitions on the shield."
size = Vector2(1, 1)
receivesSignals = "true"
statBases = SubResource(1)
graphicData = SubResource(2)
building = SubResource(5)
isMechClusterThreat = "true"
drawerType = "MapMeshAndRealTime"
placeWorkers = SubResource(6)
comps = Array[SubResource(7), SubResource(8)]
costList = SubResource(9)
resourcesFractionWhenDeconstructed = "1"
leaveResourcesWhenKilled = "false"
killedLeavings = SubResource(10)