[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ConceptDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ConceptDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/PrisonerTab.tres")"
label = "Prisoner tab"
highlightTags = SubResource(1)
helpText = Color(Look in a prisoner's 'Prisoner' tab to set how they'll be treated.\n\nYou can set whether they'll be recruited, ignored, or executed, and what kind of medical care they get. You can set food restrictions for the prisoner in their health tab.\n\nColonists with the Warden work type will interact with the prisoner.)