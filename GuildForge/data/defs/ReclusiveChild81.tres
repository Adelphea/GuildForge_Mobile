defName = "ExtResource("res://GuildForge/data/defs/ReclusiveChild81.tres")"
title = "reclusive child"
titleShort = "reclusive"
description = "[PAWN_nameDef] didn't learn to speak until [PAWN_pronoun] was nearly five years old. Even then [PAWN_pronoun] preferred to keep to [PAWN_objective]self.
\nTo the chagrin of [PAWN_possessive] caretakers, [PAWN_pronoun] made a habit of wandering off to live in the wilderness for weeks at a time."
slot = "Childhood"
