[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ThingDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/OrbitalTargeterBombardment.tres")"
label = "orbital bombardment targeter"
description = Color(An ancient targeting apparatus for an orbital bombardment system. This unit designates a target and transmits the coordinates to a network of satellites, which then bombard the target area with kinetic impactors. This unit has been reprogrammed to accept unauthorized users, but once it is used, the network will detect the incursion and cut off the link permanently.)
graphicData = SubResource(1)
apparel = SubResource(2)
thingSetMakerTags = SubResource(22)
verbs = SubResource(23)
comps = Array[SubResource(26)]