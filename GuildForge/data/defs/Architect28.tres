[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Architect28.tres")"
title = "architect"
titleShort = "architect"
description = Color([PAWN_nameDef] designed the construction of buildings. On [PAWN_possessive] glitterworld home, the technical aspect of architecture was handled by an AI, whilst the labour was done by robots. This freed [PAWN_objective] up to push the artistic limits of his craft, but also meant [PAWN_pronoun] never had to get [PAWN_possessive] hands dirty.)
slot = "Adulthood"
workDisables = SubResource(1)
requiredWorkTags = SubResource(2)
skillGains = SubResource(3)
spawnCategories = SubResource(4)
bodyTypeMale = "ExtResource("res://GuildForge/data/defs/Male.tres")"
bodyTypeFemale = "ExtResource("res://GuildForge/data/defs/Female.tres")"
possessions = SubResource(5)