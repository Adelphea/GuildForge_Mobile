[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ThingDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Harpsichord.tres")"
label = "harpsichord"
description = "A complex stationary musical instrument crafted at a smithy. A musician touches a row of keys on the front of the instrument. Each key is attached to an internal mechanism which plucks one of a row of strings stretched over a wooden frame. While it permits more complex composition than the harp, its wooden construction and plucking mechanism limit its output volume and expressiveness."
descriptionHyperlinks = SubResource(1)
size = Vector2(2, 3)
minTechLevelToBuild = "Medieval"
interactionCellOffset = Vector3(0, 0, 2)
soundPlayInstrument = "ExtResource("res://GuildForge/data/defs/Harpsichord_Play.tres")"
defaultPlacingRot = "West"
researchPrerequisites = SubResource(2)
thingSetMakerTags = SubResource(3)
statBases = SubResource(4)
recipeMaker = SubResource(5)
costList = SubResource(8)
building = SubResource(9)
graphicData = SubResource(10)