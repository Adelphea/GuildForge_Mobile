defName = "ExtResource("res://GuildForge/data/defs/NatureShrine_Small.tres")"
label = "small nature shrine"
description = Color(A small shrine for honoring spiritual beings. Tribal psycasters can focus on this shrine while meditating to increase psyfocus gain. Nature shrines lose their power if they are close to artificial structures, so they are always built in nature. Since they look like natural objects to unobservant outsiders, raiders will generally ignore them., 1.0)
