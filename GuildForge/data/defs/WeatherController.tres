[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_GameConditionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_GameConditionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/WeatherController.tres")"
conditionClass = "GameCondition_ForceWeather"
label = "forced weather"
description = "A nearby weather controller is forcing the weather into this configuration."
descriptionFuture = "a weather-control system will force the weather around [map_definite] to be [forcedWeather_indefinite] for [gameConditionDuration_duration]"
endMessage = "The weather controller is no longer changing the weather."
letterText = "A weather controller machine has begun affecting the weather."
letterDef = "ExtResource("res://GuildForge/data/defs/NegativeEvent.tres")"
canBePermanent = "false"
weatherDef = "ExtResource("res://GuildForge/data/defs/Fog.tres")"
natural = "false"