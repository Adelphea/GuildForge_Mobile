[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/UndraftAll.tres")"
text = "Success! Now UNDRAFT all your colonists using the same command as before.\n\nThis will let them return to their own schedules."
eventTagInitiate = "InstructionDeactivated-DownRaider"
instructionClass = "Instruction_UndraftAll"
actionTagsAllowed = SubResource(1)
highlightTags = SubResource(2)
rejectInputMessage = "Please un-draft your colonists."