defName = "ExtResource("res://GuildForge/data/defs/BionicStomach.tres")"
label = "bionic stomach"
labelNoun = "a bionic stomach"
description = "An installed bionic stomach. A person with this has a much lower chance of getting food poisoning, and is immune to some stomach diseases. An integrated lattice-dust healing system automatically repairs any damage to the artificial organ. It is better than a biological stomach in almost every way."
