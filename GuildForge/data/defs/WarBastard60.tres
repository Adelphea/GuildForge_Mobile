[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/WarBastard60.tres")"
title = "war bastard"
titleShort = "bastard"
description = "[PAWN_nameDef] was born nine months after [PAWN_possessive] mother's town was conquered by enemy soldiers. The child of violence with no acknowledged father, [PAWN_nameDef] grew up at the bottom of the social pyramid.
\n[PAWN_possessive] mother instilled her bitterness towards men and war into [PAWN_nameDef]. [PAWN_possessive] pet rabbit offered more warmth than any human in [PAWN_possessive] life."
slot = "Childhood"
spawnCategories = SubResource(1)
skillGains = SubResource(2)
workDisables = SubResource(3)
forcedTraits = SubResource(4)