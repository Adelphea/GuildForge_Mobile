[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ThingDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Plant_HealrootWild.tres")"
label = "wild healroot"
description = "A slow-growing plant which yields herbal medicine when harvested.\n\nThis wild breed of healroot is hardier than domesticated healroot, but too difficult to cultivate. It is prized by tribespeople in colder climates."
neverMultiSelect = "false"
plant = SubResource(1)