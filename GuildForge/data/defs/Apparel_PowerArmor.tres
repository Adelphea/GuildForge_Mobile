[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ThingDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Apparel_PowerArmor.tres")"
label = "marine armor"
description = "A suit of powered armor. Layered plasteel-weave plates are very effective at stopping attacks, with few vulnerable joint sections. Neuro-memetic assistors allow a human to wear the armor and still move easily.\n\nArmor like this is often used by rapid-incursion space marines."
apparel = SubResource(1)
recipeMaker = SubResource(3)