[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Pyromaniac18.tres")"
title = "pyromaniac"
titleShort = "pyro"
description = Color(From an early age, [PAWN_nameDef] had an unhealthy fascination with fire. [PAWN_pronoun] would set refuse heaps ablaze and become so entranced by the flames [PAWN_pronoun] would absent-mindedly burn [PAWN_objective]self.\n\nOne day while playing with matches, [PAWN_pronoun] carelessly burned down [PAWN_possessive] home., 1.0)
slot = "Childhood"
workDisables = SubResource(1)
skillGains = SubResource(2)
spawnCategories = SubResource(3)
forcedTraits = SubResource(4)