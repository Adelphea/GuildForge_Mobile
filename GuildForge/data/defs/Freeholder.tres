[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_RoyalTitleDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Freeholder.tres")"
label = "freeholder"
description = "The Imperial title of freeholder is used by the Empire to signifies a fully-respected individual. Most Imperial citizens earn it while young through volunteer work or military service. The title is also offered to outsiders who act with honor in the eyes of the Empire."
