[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/HypothermicSlowdown.tres")"
label = "hypothermic slowdown"
description = Color(A special biological state used by some creatures to survive extreme cold. Instead of trying to stay warm, the creature's body chemistry adapts to prevent internal freezing despite very low temperature. Bodily functions are slowed and capacities are reduced, but the cold does no permanent damage. Some biologists call it a wakeful form of hibernation., 1.0)
defaultLabelColor = Vector3(0.8, 0.8, 1)
stages = SubResource(1)