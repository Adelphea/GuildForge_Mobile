[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/NuclearStomach.tres")"
label = "nuclear stomach"
description = Color(A micro-nuclear reactor combined with complex chemical synthesis replaces the body's need for food energy. Food is required only to replace matter lost from the body, reducing the user's intake needs significantly. This artificial stomach cannot get food poisoning. However, there is little room to shield the reactor, so the radiation increases the risk of cancer.)
