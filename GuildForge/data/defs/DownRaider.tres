[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/DownRaider.tres")"
text = Color(I've now sent a raider to attack your colony!\n\n1. Pause the game by hitting {Key:TogglePause}!\n2. Read the red letter in the bottom-right of the screen.\n3. DRAFT your colonists by selecting them and hitting the DRAFT command.\n4. Right-click to send them to positions inside the sandbag square, touching the sandbags.\n5. Unpause.\n\nColonists must be touching cover to benefit from it. Once you're in cover, wait for the attacker to approach. Your colonists will shoot automatically., 1.0)
textController = Color(I've now sent a raider to attack your colony!\n\n1. Pause the game by hitting {Key:TogglePause}!\n2. Read the red letter in the bottom-right of the screen.\n3. DRAFT your colonists by selecting them and hitting the DRAFT command.\n4. Press left trigger button to send them to positions inside the sandbag square, touching the sandbags.\n5. Unpause.\n\nColonists must be touching cover to benefit from it. Once you're in cover, wait for the attacker to approach. Your colonists will shoot automatically., 1.0)
eventTagInitiate = "InstructionDeactivated-FinishSandbags"
instructionClass = "Instruction_DownRaider"
actionTagsAllowed = SubResource(1)
highlightTags = SubResource(2)
rejectInputMessage = "Please focus on winning the fight!"
onMapInstruction = "Send colonists here\ntouching sandbags for cover"