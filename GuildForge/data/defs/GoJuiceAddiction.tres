[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/GoJuiceAddiction.tres")"
label = "go-juice addiction"
description = "A chemical addiction to go-juice. Long-term presence of go-juice has caused neurological adaptations at the cellular level, so the brain can no longer function properly without the drug.
\nWithout regular doses of go-juice, withdrawal symptoms will begin. However, extended abstinence will force the brain to adapt back to its normal state, resolving the addiction."
hediffClass = "Hediff_Addiction"
chemicalNeed = "ExtResource("res://GuildForge/data/defs/Chemical_GoJuice.tres")"
comps = Array[SubResource(1)]
stages = SubResource(2)