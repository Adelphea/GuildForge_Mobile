[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ThingDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Plant_TreeGauranlen.tres")"
label = "Gauranlen tree"
description = Color(A large, distinctive-looking tree with a unique life-cycle. Each Gauranlen tree contains a small non-conscious dryad queen. The queen births creatures called dryads which guard and tend the tree. In exchange, the tree nurtures its protectors by feeding them directly. From the outside, it appears the dryads are created by the tree directly and act as part of it.\n\nIt is possible for a person to form a connection with a Gauranlen tree and partially control the dryads it produces.\n\nSome say Gauranlen trees are the homes of nature spirits that follow humanity across worlds.)
drawerType = "MapMeshAndRealTime"
graphicData = SubResource(1)
tickerType = "ExtResource("res://GuildForge/data/defs/Normal.tres")"
canScatterOver = "false"
descriptionHyperlinks = SubResource(3)
minifiedDef = SubResource(4)
statBases = SubResource(5)
ingestible = None
preventSkyfallersLandingOn = "true"
notifyMapRemoved = "true"
plant = SubResource(6)
comps = Array[SubResource(9), SubResource(13), SubResource(14), SubResource(15)]
ritualFocus = SubResource(24)
drawPlaceWorkersWhileSelected = "true"
placeWorkers = SubResource(25)