[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_ConceptDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ConceptDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Capturing.tres")"
label = "ExtResource("res://GuildForge/data/defs/Capturing.tres")"
helpText = "When an enemy is downed on the ground but not dead, you can CAPTURE them.\n\nTo capture, select a colonist, right-click on the incapacitated enemy, and select Capture.\n\nYou'll need an extra bed marked for prisoner use."
helpTextController = "When an enemy is downed on the ground but not dead, you can CAPTURE them.\n\nTo capture, select a colonist, press the left trigger button on the incapacitated enemy, and select Capture.\n\nYou'll need an extra bed marked for prisoner use."