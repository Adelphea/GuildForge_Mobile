spawnCategories = SubResource(3)
bodyTypeMale = "ExtResource("res://GuildForge/data/defs/Male.tres")"
bodyTypeFemale = "ExtResource("res://GuildForge/data/defs/Female.tres")"
possessions = SubResource(4)