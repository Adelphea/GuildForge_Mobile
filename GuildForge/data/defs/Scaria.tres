[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Scaria.tres")"
label = "scaria"
description = Color(An infectious disease which can drive humans and animals into a berserk rage. Scaria can be cured through a special medical operation, but the creature must first be downed in order to make it possible to operate. The disease poisons the flesh, so creatures killed with scaria often appear rotten after death and cannot be butchered for meat or leather. After scaria rage has begun, the creature will last several days before dying from exhaustion. Scaria-infected animals can't be tamed.)
descriptionShort = "An infectious disease which can drive humans and animals into a berserk rage. Scaria-infected animals can't be tamed."
hediffClass = "Hediff_Scaria"
initialSeverity = "1"
skinColorTint = Vector3(0.37, 0.15, 0.1)
skinColorTintStrength = "0.4"
forceRenderTreeRecache = "true"
inspectString = "Scaria infected."
renderNodeProperties = SubResource(1)