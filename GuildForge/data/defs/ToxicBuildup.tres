[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/ToxicBuildup.tres")"
label = "toxic buildup"
description = "Poison in the bloodstream. This can come from various sources, including environmental toxins, venomous bites, or poisoned weapons.
\nAt high doses, toxic buildup is lethal. Even at low doses, it can generate cancers.
\nIf a creature dies with toxic buildup, there's a chance that they cannot be eaten. The higher the toxic buildup, the higher the chance."
hediffClass = "HediffWithComps"
defaultLabelColor = Vector3(0.7, 1.0, 0.7)
lethalSeverity = "1"
canApplyDodChanceForCapacityChanges = "true"
makesSickThought = "true"
scenarioCanAdd = "true"
taleOnVisible = "ExtResource("res://GuildForge/data/defs/ToxicityRevealed.tres")"
comps = Array[SubResource(1), SubResource(2)]
stages = SubResource(3)