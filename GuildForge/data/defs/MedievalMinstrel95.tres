defName = "ExtResource("res://GuildForge/data/defs/MedievalMinstrel95.tres")"
title = "medieval minstrel"
titleShort = "minstrel"
description = Color([PAWN_nameDef] was a traveling entertainer on a medieval world and [PAWN_pronoun] could always be found telling stories or singing songs.\n\nThe roads were dangerous, so [PAWN_pronoun] is capable of protecting [PAWN_objective]self. However, [PAWN_pronoun] would always move on when there was hard labour to be done., 1.0)
slot = "Adulthood"
workDisables = SubResource(1)
skillGains = SubResource(2)
spawnCategories = SubResource(3)
bodyTypeMale = "ExtResource("res://GuildForge/data/defs/Fat.tres")"
bodyTypeFemale = "ExtResource("res://GuildForge/data/defs/Fat.tres")"