[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/UnwantedSurvivor67.tres")"
title = "unwanted survivor"
titleShort = "survivor"
description = "[PAWN_nameDef]'s noble family did not want [PAWN_objective], but could not afford to be seen directly assassinating [PAWN_objective] either. They attempted to get [PAWN_objective] killed by assigning [PAWN_objective] dangerous training without proper protection at too young an age.
\nAgainst all odds, [PAWN_nameDef] survived the jousting contests, horsewar matches, riverrun competitions and warzones. In the end, it only made [PAWN_objective] stronger."
slot = "Childhood"
spawnCategories = SubResource(1)
skillGains = SubResource(2)
workDisables = SubResource(3)
forcedTraits = SubResource(4)