[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_BackstoryDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/MedievalFarmOaf58.tres")"
title = "medieval farm oaf"
titleShort = "oaf"
description = "Tilling, hoeing, guiding ox carts, pushing wheelbarrows. Digging ditches, planting seeds, predicting the harvest.\n\nMedieval-level farmers aren't educated in the usual sense, but they know a lot about growing plants without technology. That said, such a life can leave one  incapable of participating in technology-driven activities."
slot = "Adulthood"
skillGains = SubResource(1)
spawnCategories = SubResource(2)
workDisables = SubResource(3)
requiredWorkTags = SubResource(4)
bodyTypeGlobal = "ExtResource("res://GuildForge/data/defs/Fat.tres")"