[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ThingDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/StoneskinGland.tres")"
label = "stoneskin gland"
description = Color(This bionic gland releases chemical and nanomachines that transform the user's skin into a built-in suit of armor. The whole epidermis thickens and hardens to resist burns, while jointed exterior keratin plates form everywhere they can - including the head and face. While it's very difficult to physically hurt someone using this implant, the plates and hard skin significantly reduces the user's physical attractiveness., 1.0)
descriptionHyperlinks = SubResource(1)
thingSetMakerTags = SubResource(2)
costList = SubResource(3)
recipeMaker = SubResource(4)