[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/ReorderCharacters.tres")"
text = "Now you choose which characters you want to use.\n\nDRAG a character from the "left behind" part of the character list (at the bottom) into the "selected" part (at the top).\n\nOptionally, clicking a character will allow you inspect him or her."
eventTagInitiate = "PageStart-ConfigureStartingPawns"
actionTagsAllowed = SubResource(1)
eventTagsEnd = SubResource(2)
highlightTags = SubResource(3)
rejectInputMessage = "Please drag a character from the "left behind" group (at the bottom-left) into the "selected" group (at the upper-left)."