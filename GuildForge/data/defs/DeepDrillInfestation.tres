[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_IncidentDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_IncidentDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/DeepDrillInfestation.tres")"
label = "deep drill infestation"
