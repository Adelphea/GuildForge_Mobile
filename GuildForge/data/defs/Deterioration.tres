[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ConceptDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Deterioration.tres")"
label = "Item deterioration"
priority = "6"
helpText = "Items left outdoors will slowly deteriorate.\n\nIf you want to store items long-term, keep them in a roofed room."