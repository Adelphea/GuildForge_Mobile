[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/Abasia.tres")"
label = "paralytic abasia"
description = Color(A condition that makes a person unable to walk by interfering with the motor cortex. After enough time, patients recover naturally as the brain rewires itself, but the process is slow. There is also a chance of a lucky early recovery. This illness can be completely cured with a special procedure, but the procedure requires large amounts of glitterworld medicine.)
descriptionShort = "A neurological condition that makes a person unable to walk. Patients recover naturally but the process is slow."
hediffClass = "HediffWithComps"
preventsCrawling = "true"
comps = Array[SubResource(1), SubResource(2)]
stages = SubResource(3)