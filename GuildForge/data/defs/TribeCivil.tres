[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_FactionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_FactionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/TribeCivil.tres")"
label = "gentle tribe"
description = "These people have been here a very long time. Maybe their ancestors crashed here a thousand years ago. Maybe they survived some cataclysm that destroyed a technological civilization here. In any case, the tribals are mostly nomadic people who live off the land using primitive tools and weapons.\n\nDespite their apparent technological weakness, the tribals can be dangerous enemies and valuable friends because of their skill with low-tech warfare, their numbers, and their hardiness.\n\nThis particular tribe pursues a gentle way of life where they can. They are quite open to trade and alliances, even with strange peoples."
colorSpectrum = SubResource(1)
disallowedMemes = SubResource(2)
maxConfigurableAtWorldCreation = "9999"
configurationListOrderPriority = "30"