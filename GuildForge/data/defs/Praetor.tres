defName = "ExtResource("res://GuildForge/data/defs/Praetor.tres")"
label = "praetor"
description = "The title of praetor denotes a member of the psychic cult who carries out field missions in a more senior role than a mere knight. Praetors often act alone, but may also command knights and lower members.\n\nDuring peacetime, a praetor will usually manage a city district, asteroid sector, or agricultural region. During war, they take authority over the smallest independent combat units - terrestrial troop cohorts, or space-borne destroyers or combat groups."
