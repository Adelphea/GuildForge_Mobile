[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_PreceptDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/IdeoRole_ShootingSpecialist.tres")"
label = "shooting specialist"
description = "A special ideoligious status focusing on ranged combat to the exclusion of all else. This specialized role gives increased accuracy and the ability to boost the shooting abilities of nearby allies. Holders of this role will refuse to do many kinds of non-shooting-related work."
