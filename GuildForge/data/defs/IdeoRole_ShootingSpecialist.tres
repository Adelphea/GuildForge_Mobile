roleTags = SubResource(5)
requiredMemes = SubResource(6)
roleEffects = SubResource(7)
grantedAbilities = SubResource(11)
displayOrderInImpact = "2"
roleDisabledWorkTags = SubResource(12)
roleApparelRequirements = SubResource(13)