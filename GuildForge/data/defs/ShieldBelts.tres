[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_ConceptDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/ShieldBelts.tres")"
label = "Shield belts"
helpText = Color(Shield belts stop ranged attacks from coming in or out. They have no effect on melee attacks.\n\nTo fight against shield belts, either concentrate a lot of gunfire on the target, or fight hand-to-hand., 1.0)