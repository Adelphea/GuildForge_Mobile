[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/AddBillSimpleMeal.tres")"
text = Color(Colonists need to be told what to cook.\n\nCooking orders are added on the stove itself. Once a bill has been created, colonists will do the work automatically.\n\n1. Wait for the stove to be built.\n2. Click the stove to select it.\n3. Open the BILLS tab.\n4. Click ADD BILL.\n5. Select COOK SIMPLE MEAL on the context menu.\n6. Click the + button to increase the count to 10.\n\nRemember, you can speed up time if building is taking too long.\n\nYou can also select a colonist and right-click the stove to prioritize building it., 1.0)
textController = Color(Colonists need to be told what to cook.\n\nCooking orders are added on the stove itself. Once a bill has been created, colonists will do the work automatically.\n\n1. Wait for the stove to be built.\n2. Click the stove to select it.\n3. Open the BILLS tab.\n4. Click ADD BILL.\n5. Select COOK SIMPLE MEAL on the context menu.\n6. Click the + button to increase the count to 10.\n\nRemember, you can speed up time if building is taking too long.\n\nYou can also select a colonist and press left trigger button on the stove to prioritize building it., 1.0)
instructionClass = "Instruction_AddBill"
eventTagInitiate = "InstructionDeactivated-BuildFueledStove"
actionTagsAllowed = SubResource(1)
highlightTags = SubResource(2)
rejectInputMessage = "Please add a bill to cook simple meals at your cook stove."
onMapInstruction = "Select this"
thingDef = "ExtResource("res://GuildForge/data/defs/FueledStove.tres")"
recipeDef = "ExtResource("res://GuildForge/data/defs/CookMealSimple.tres")"
recipeTargetCount = "10"
giveOnActivateDef = "ExtResource("res://GuildForge/data/defs/RawPotatoes.tres")"
giveOnActivateCount = "75"