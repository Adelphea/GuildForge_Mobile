[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_HediffDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_HediffDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/CryptosleepSickness.tres")"
label = "cryptosleep sickness"
description = "After-effects of using a cryptosleep pod. Cryptosleep suspends and replaces many bodily functions in order to prevent aging and death. Upon exiting cryptosleep, the body takes time to restart and rebalance its natural metabolic processes. While this is ongoing, the patient suffers from nausea, dizziness, and a sense of fuzziness in the mind."
descriptionShort = Color(After-effects of using a cryptosleep pod including dizziness, nausea, and vomiting., 1.0)
makesSickThought = "true"
scenarioCanAdd = "true"
comps = Array[SubResource(1)]
stages = SubResource(2)