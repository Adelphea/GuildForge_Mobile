[gd_resource type="Script" path="res://GuildForge/scripts/resources/CR_InstructionDef.gd" id=1]

[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_InstructionDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/BuildSandbags.tres")"
text = "Great! You've now got a basic colony running! Eventually, enemies will raid your colony. It's time to prepare for that.\n\nSelect the SANDBAGS designator and drag the sandbags out at the designated area."
instructionClass = "Instruction_BuildSandbags"
eventTagInitiate = "InstructionDeactivated-ExpandAreaBuildRoof"
actionTagsAllowed = SubResource(1)
highlightTags = SubResource(2)
rejectInputMessage = "Please build sandbags in the highlighted area."
onMapInstruction = "Build sandbags here"