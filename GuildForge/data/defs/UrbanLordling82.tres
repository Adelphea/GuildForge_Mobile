[resource]
script = ExtResource("res://res://GuildForge/scripts/resources/CR_BackstoryDef.gd")
defName = "ExtResource("res://GuildForge/data/defs/UrbanLordling82.tres")"
title = "urban lordling"
titleFemale = "urban lady"
titleShort = "city lord"
titleShortFemale = "city lady"
description = "[PAWN_nameDef] was born to a royal house with a grand manor in a great city. [PAWN_pronoun] spent [PAWN_possessive] youth in lessons on politics.
\nWhenever [PAWN_pronoun] could, [PAWN_pronoun] would escape with [PAWN_possessive] friends to explore the half-built substructure of the metropolis."
slot = "Childhood"
spawnCategories = SubResource(1)
skillGains = SubResource(2)