# -----------------------------
# Fichiers temporaires générés par éditeurs ou IA
# -----------------------------
__pycache__/       # Python bytecode si scripts utilisés
*.tmp              # Fichiers temporaires génériques
*.log              # Fichiers de log
.env               # Variables d'environnement sensibles

# -----------------------------
# Fichiers générés par Godot ou outils similaires
# -----------------------------
*.import           # Fichiers d'import Godot
*.converted        # Fichiers convertis automatiquement
*.mono             # Dossier mono C# généré par Godot
*.cache            # Cache temporaire Godot ou autre
*.export           # Export temporaire du projet

# -----------------------------
# Fichiers inutiles pour la documentation
# -----------------------------
*.swp              # Fichiers temporaires Vim/Éditeurs
*.bak              # Sauvegardes
*.orig             # Fichiers de fusion Git
